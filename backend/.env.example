# ==============================================================================
# SMART AIoT SECURITY - BACKEND CONFIG TEMPLATE (.env.example)
# ==============================================================================

# Server Express.js
NODE_ENV=development
PORT=8000
PROJECT_NAME="SMART AIoT SECURITY"
VERSION="1.0.0"

# Cấu hình Cơ sở dữ liệu ('postgres' hoặc 'sqlite')
DB_DRIVER=postgres

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password123@localhost:5432/smart_aiot_security?sslmode=disable

# PostgreSQL Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_aiot_security
DB_USER=postgres
DB_PASSWORD=password123
DB_SCHEMA=public
DB_SSL=false

# PostgreSQL Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# SQLite Fallback (nếu DB_DRIVER=sqlite)
DATABASE_PATH=database/security.db
SCHEMA_PATH=database/schema.sql

# MQTT Broker (Mosquitto / EMQX)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=NodeJS_Backend_Service
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# AI Isolation Forest
AI_CONTAMINATION=0.05
AI_N_ESTIMATORS=100
