#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// ==============================================================================
// THÔNG TIN KẾT NỐI WI-FI VÀ MQTT BROKER (FILE MẪU)
// ==============================================================================
// Hướng dẫn: 
// 1. Sao chép file này và đổi tên thành 'credentials.h' (trong cùng thư mục include)
// 2. Điền thông tin Wi-Fi và địa chỉ IP máy tính chạy Mosquitto Broker của bạn
// 3. File 'credentials.h' đã được thêm vào .gitignore nên sẽ không bị lộ lên Git
// ==============================================================================

#define WIFI_SSID           "YOUR_WIFI_SSID"        // Tên Wi-Fi (chỉ dùng băng tần 2.4GHz)
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"    // Mật khẩu Wi-Fi
#define MQTT_BROKER_IP      "192.168.1.100"         // Địa chỉ IP của máy tính chạy Mosquitto
#define MQTT_BROKER_PORT    1883                    // Cổng mặc định của Mosquitto

#endif // CREDENTIALS_H
