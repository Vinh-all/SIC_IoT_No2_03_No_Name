# ==============================================================================
# SMART AIoT SECURITY - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành '.env' và điền cấu hình thực tế cho hệ thống.

# Tên dự án & Phiên bản
PROJECT_NAME="SMART AIoT SECURITY"
VERSION="1.0.0"

# Cấu hình MQTT Broker Mosquitto
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=FastAPI_Backend_Service

# Cấu hình Đường dẫn Database SQLite
DATABASE_PATH=database/security.db
SCHEMA_PATH=database/schema.sql

# Cấu hình Mô hình Trí tuệ Nhân tạo (Isolation Forest)
AI_CONTAMINATION=0.05
AI_N_ESTIMATORS=100
